<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp">

    <EditText
        android:id="@+id/etGuardianName"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="2.5"
        android:hint="이름을 입력해주세요"
        android:textSize="12sp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="@drawable/bg_card_outline"
        android:layout_marginRight="2dp" />

    <Spinner
        android:id="@+id/spinnerRelation"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1.5"
        android:background="@drawable/bg_card_outline"
        android:layout_marginRight="2dp" />

    <EditText
        android:id="@+id/etGuardianPhone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="3"
        android:hint="예시)010-0000-0000"
        android:inputType="phone"
        android:textSize="12sp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="@drawable/bg_card_outline" />

    <ImageButton
        android:id="@+id/btnRemoveGuardian"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:layout_marginLeft="4dp"
        android:src="@android:drawable/ic_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="보호자 삭제" />

</LinearLayout>
