<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp">

    <EditText
        android:id="@+id/etOrgName"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="2"
        android:hint="기관명"
        android:textSize="11sp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:background="@drawable/bg_card_outline"
        android:layout_marginRight="2dp" />

    <EditText
        android:id="@+id/etOrgManager"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1.5"
        android:hint="담당자"
        android:textSize="11sp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:background="@drawable/bg_card_outline"
        android:layout_marginRight="2dp" />

    <EditText
        android:id="@+id/etOrgPhone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="2"
        android:hint="예시)010-0000-0000"
        android:inputType="phone"
        android:textSize="11sp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:background="@drawable/bg_card_outline"
        android:layout_marginRight="2dp" />

    <EditText
        android:id="@+id/etOrgNote"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1.5"
        android:hint="비고"
        android:textSize="11sp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:background="@drawable/bg_card_outline" />

    <ImageButton
        android:id="@+id/btnRemoveOrg"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:layout_marginLeft="4dp"
        android:src="@android:drawable/ic_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="연계기관 삭제" />

</LinearLayout>
