<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    tools:context="com.siheung.careconnect.login.SignUpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <!-- 뒤로가기 버튼 -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 뒤로가기"
            android:textSize="14sp"
            android:textColor="#3D5AFE"
            android:background="@android:color/transparent"
            android:layout_marginBottom="8dp"/>

        <!-- 헤더 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회원가입"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#3D5AFE"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="돌봄 커넥트에 오신 것을 환영합니다"
            android:textSize="13sp"
            android:textColor="#9E9E9E"
            android:layout_marginBottom="24dp"/>

        <!-- ── 계정 정보 카드 ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="계정 정보"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="16dp"/>

                <!-- 아이디 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아이디"
                    android:textSize="13sp"
                    android:textColor="#616161"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="아이디를 입력하세요 (영문, 숫자)"
                    android:inputType="text"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp"/>

                <!-- 이메일 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이메일"
                    android:textSize="13sp"
                    android:textColor="#616161"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="이메일을 입력하세요"
                    android:inputType="textEmailAddress"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp"/>

                <!-- 비밀번호 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호"
                    android:textSize="13sp"
                    android:textColor="#616161"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="비밀번호를 입력하세요 (8자 이상)"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp"/>

                <!-- 비밀번호 재확인 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호 재확인"
                    android:textSize="13sp"
                    android:textColor="#616161"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etPasswordConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="비밀번호를 다시 입력하세요"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvPasswordError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호가 일치하지 않습니다."
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:visibility="gone"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── 자녀 정보 카드 ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="자녀 정보"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="16dp"/>

                <!-- 자녀 이름 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="자녀 이름"
                    android:textSize="13sp"
                    android:textColor="#616161"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etChildName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="자녀 이름을 입력하세요"
                    android:inputType="textPersonName"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp"/>

                <!-- 자녀 생년월일 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="자녀 생년월일"
                    android:textSize="13sp"
                    android:textColor="#616161"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etChildBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="YYYY-MM-DD"
                    android:inputType="datetime"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp"/>

                <!-- 소득분위 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="소득분위 (선택)"
                    android:textSize="13sp"
                    android:textColor="#616161"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etIncomeLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="1~10 사이 숫자 입력 (맞춤형 혜택에 활용됩니다)"
                    android:inputType="number"
                    android:padding="14dp"
                    android:textSize="15sp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── 약관 동의 카드 ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="약관 동의"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <CheckBox
                    android:id="@+id/cbAgreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="이용약관 및 개인정보 처리방침에 동의합니다. (필수)"
                    android:textColor="#424242"
                    android:textSize="14sp"/>

                <CheckBox
                    android:id="@+id/cbPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="자녀 정보 수집·이용에 동의합니다. (필수)"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 입력완료 버튼 -->
        <Button
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="입력완료"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#3D5AFE"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>